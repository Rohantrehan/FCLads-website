# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project settings → API). The publishable key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public address of the site, used in sign-up and password reset emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Design preview only (development builds): show the site as a signed-in FC Lads+ member.
# DEV_VIEWER=member

# Secret key (Project settings → API keys → Secret keys). Server only, never expose it to the browser.
# The website reads all content with it. Leave empty to show the sample content in src/data.
SUPABASE_SECRET_KEY=

# Address of the hidden posting board, e.g. lads-board-k3x9q2 → https://fclads.com/lads-board-k3x9q2
# Lowercase letters, numbers and dashes. Leave empty to switch the board off. Change it if it leaks;
# only creators and admins can use it anyway.
BOARD_PATH=
