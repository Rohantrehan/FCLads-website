# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project settings → API). The publishable key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public address of the site, used in sign-up and password reset emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Design preview only (development builds): show the site as a signed-in FC Lads+ member.
# DEV_VIEWER=member

# Sanity CMS (sanity.io/manage → your project). Leave empty to show the sample content in src/data.
# SANITY_READ_TOKEN: API → Tokens → "Viewer" token. Server only, never expose it to the browser.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_READ_TOKEN=
# Same secret as the Sanity webhook that calls /api/revalidate on publish.
SANITY_WEBHOOK_SECRET=
